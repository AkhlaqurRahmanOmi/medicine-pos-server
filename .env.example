# Medicine POS Backend — copy to `.env` (which is gitignored) and adjust.
#
# Two groups: what the server reads, and what `compose.yaml` reads. The server never reads
# the second group, and compose never reads the first — except that the ports must agree,
# since the server runs on the host and the tools run in containers.

# ---------------------------------------------------------------- the server reads these
APP_ENV=development
APP_PORT=8080

# Owner role runs migrations; the app connects as the NON-owner role. Constitution
# Article IV.1 — the owner bypasses RLS silently, so these two must never be swapped.
DATABASE_URL=postgres://pos_owner:devpass@localhost:5432/medicine_pos
APP_DATABASE_URL=postgres://pos_app:devpass@localhost:5432/medicine_pos
REDIS_URL=redis://localhost:6379

JWT_SECRET=dev-only-change-me
RUST_LOG=server=debug,tower_http=debug,sea_orm=debug

# Object storage and mail, behind `trait FileStorage` and `trait MailSender`. NOTHING READS
# THESE YET — the adapters are not written, and no container serves them. Provisional names
# until module 00's `config.rs` task settles them.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=medicine-pos-uploads
S3_BACKUP_BUCKET=medicine-pos-backups
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
SMTP_HOST=localhost
SMTP_PORT=1025

# ------------------------------------------------------------- compose.yaml reads these
# Images are pinned and overridable: a tag that moves under you is a debugging session.
TZ=Asia/Dhaka
COMPOSE_PROJECT_NAME=medicine-pos

POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_PORT=5432
POSTGRES_DB=medicine_pos
# The image's superuser — NOT pos_owner, which bootstrap.sql creates itself.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=devpass
# Provisions pos_owner, pos_app and pos_jobs on the volume's first boot only.
POSTGRES_INIT_SQL=./docs/db/bootstrap.sql

REDIS_IMAGE=redis:7.4-alpine
REDIS_PORT=6379


